<Window x:Class="Snatch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snatch 설정" Width="680" Height="700"
        WindowStartupLocation="CenterScreen" Background="#FF0F0F0F"
        ThemeMode="Dark"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- 왼쪽 메뉴 항목 -->
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,6" Margin="0,0,0,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 묶음 카드 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF171717"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- 카드 안 한 줄 -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Line" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>
        <!-- 강조색: 윈도 강조색(사람마다 다름) 대신 편집기와 같은 파랑 -->
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60A84FF"/>
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0A84FF"/>
        <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#0A84FF"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E60A84FF"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#CC0A84FF"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#0A84FF"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#0A84FF"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#0A84FF"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="hv" Background="#14FFFFFF" CornerRadius="8" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hv" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="hv" Property="Background" Value="#33000000"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#FF0A0A0A" Padding="10,12">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="20,14,20,0"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- 캡처 -->
            <TabItem Header="캡처" Style="{StaticResource NavTab}">
                <StackPanel>
                    <TextBlock Text="캡처" Style="{StaticResource Title}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="캡처하면 클립보드에도 복사" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="ClipChk" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="저장 폴더" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="ShotDirText" Grid.Column="1" Style="{StaticResource Sub}" Margin="16,0,0,0"/>
                                <Button Grid.Column="2" Content="변경" Click="OnPickShotDir"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 알림 · 소리 -->
            <TabItem Header="알림 · 소리" Style="{StaticResource NavTab}">
                <StackPanel>
                    <TextBlock Text="알림 · 소리" Style="{StaticResource Title}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="소리 켜기" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="SoundChk" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="다운로드 소리" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="SoundText" Grid.Column="1" Style="{StaticResource Sub}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="▶" Click="OnTestSound" ToolTip="듣기"/>
                                    <Button Content="파일 선택" Click="OnPickSound"/>
                                    <Button Content="기본" Click="OnDefaultSound"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="캡처 소리" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="CapSoundText" Grid.Column="1" Style="{StaticResource Sub}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="▶" Click="OnTestCapSound" ToolTip="듣기"/>
                                    <Button Content="파일 선택" Click="OnPickCapSound"/>
                                    <Button Content="기본" Click="OnDefaultCapSound"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="알림 위치" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="PosBox" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="Right">오른쪽 아래</ComboBoxItem>
                                    <ComboBoxItem Tag="Center">가운데 아래</ComboBoxItem>
                                    <ComboBoxItem Tag="Left">왼쪽 아래</ComboBoxItem>
                                    <ComboBoxItem Tag="Mouse">마우스 근처</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="알림 자동으로 닫기 (초)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="HideBox" Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 다운로드 -->
            <TabItem Header="다운로드" Style="{StaticResource NavTab}">
                <StackPanel>
                    <TextBlock Text="다운로드" Style="{StaticResource Title}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="지켜보는 폴더" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="DlText" Grid.Column="1" Style="{StaticResource Sub}" Margin="16,0,0,0" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="유튜브 링크 복사하면 자동 다운로드" Style="{StaticResource Label}"/>
                                    <TextBlock Text="1080p H264" Style="{StaticResource Sub}"/>
                                </StackPanel>
                                <CheckBox x:Name="YtChk" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"/>
                            </Grid>
                            <Border Style="{StaticResource Line}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="저장 폴더" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="YtDirText" Grid.Column="1" Style="{StaticResource Sub}" Margin="16,0,0,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="열기" Click="OnOpenYtDir"/>
                                    <Button Content="변경" Click="OnPickYtDir"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 자동 바꾸기 -->
            <TabItem Header="자동 바꾸기" Style="{StaticResource NavTab}">
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="자동 바꾸기" Style="{StaticResource Title}"/>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="단축어 치면 문장으로 바꾸기" Style="{StaticResource Label}"/>
                                <TextBlock Text="예: shh → 이메일 · 영문 입력에선 영문·숫자, 한글 입력에선 자음(ㅅㅅㅅ) 단축어" Style="{StaticResource Sub}"/>
                            </StackPanel>
                            <CheckBox x:Name="ExpandChk" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,10,0,6">
                        <TextBox x:Name="SnipSearch" TextChanged="OnSnipSearch" ToolTip="단축어나 문장으로 찾기"/>
                        <TextBlock x:Name="SnipHint" Text="🔍 검색" Foreground="#8A8A8A" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <ListBox x:Name="SnipList" Grid.Row="3" SelectionChanged="OnSnipSelect" MinHeight="60">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,3"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <!-- ⏎·→ 같은 기호가 다른 글꼴로 떠서 행간이 벌어지는 걸 막으려고 줄 높이를 고정 -->
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="18"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SnipMode" Text="새 단축어" Style="{StaticResource Sub}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="단축어" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox x:Name="SnipTrigger" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="바뀔 문장" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SnipText" Grid.Row="1" Grid.Column="1" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button x:Name="SnipSaveBtn" Content="추가" Click="OnSnipSave" MinWidth="90" Margin="0,0,6,0"/>
                                <Button Content="새로 쓰기" Click="OnSnipNew" MinWidth="90" Margin="0,0,6,0"/>
                                <Button x:Name="SnipDelBtn" Content="삭제" Click="OnSnipRemove" MinWidth="90"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 즐겨찾기 -->
            <TabItem Header="즐겨찾기 폴더" Style="{StaticResource NavTab}">
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="즐겨찾기 폴더" Style="{StaticResource Title}"/>
                    <ListBox x:Name="FavList" Grid.Row="1"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="+ 폴더 추가" Click="OnAddFav"/>
                        <Button Content="선택 삭제" Click="OnRemoveFav"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#FF0A0A0A" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SavedText" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="저장" Click="OnSave" Style="{StaticResource Accent}" Padding="20,5" Margin="0"/>
                <Button Content="닫기" Click="OnCloseBtn" Padding="20,5" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
